{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hcns/external-dataset-aggregate-pilot-1.0.0.schema.json",
  "title": "DATA-09 External Dataset Aggregate-only Pilot Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pilot", "dataset", "scope", "normalization", "reportPolicy", "promotionDecision"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "pilot": {"const": "DATA-09"},
    "dataset": {"$ref": "#/$defs/dataset"},
    "scope": {"$ref": "#/$defs/scope"},
    "normalization": {"$ref": "#/$defs/normalization"},
    "reportPolicy": {"$ref": "#/$defs/reportPolicy"},
    "promotionDecision": {"$ref": "#/$defs/promotionDecision"}
  },
  "$defs": {
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetId", "version", "contentDigest", "groundTruthSha256", "groundTruthStatus"],
      "properties": {
        "datasetId": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "contentDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "groundTruthSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "groundTruthStatus": {"const": "SEALED"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventoryDocumentCount", "activeDocumentCount", "outOfScopeDocumentCount", "activeFieldCount"],
      "properties": {
        "inventoryDocumentCount": {"type": "integer", "minimum": 1},
        "activeDocumentCount": {"type": "integer", "minimum": 1},
        "outOfScopeDocumentCount": {"type": "integer", "minimum": 0},
        "activeFieldCount": {"type": "integer", "minimum": 1}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "normalizationCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentCount", "fieldCount", "normalizationStatusCounts", "dataTypeCounts"],
      "properties": {
        "documentCount": {"type": "integer", "minimum": 1},
        "fieldCount": {"type": "integer", "minimum": 1},
        "normalizationStatusCounts": {"$ref": "#/$defs/counts"},
        "dataTypeCounts": {"$ref": "#/$defs/counts"}
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statusCounts", "dataTypeCounts", "normalizedFieldCount", "missingFieldCount", "needsReviewFieldCount", "byCategory"],
      "properties": {
        "statusCounts": {"$ref": "#/$defs/counts"},
        "dataTypeCounts": {"$ref": "#/$defs/counts"},
        "normalizedFieldCount": {"type": "integer", "minimum": 0},
        "missingFieldCount": {"type": "integer", "minimum": 0},
        "needsReviewFieldCount": {"type": "integer", "minimum": 0},
        "byCategory": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/normalizationCategory"}
        }
      }
    },
    "reportPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregateOnly", "containsRawFieldValues", "containsRawOcrText", "containsPredictions", "predictionsOpened", "promotionAllowed"],
      "properties": {
        "aggregateOnly": {"const": true},
        "containsRawFieldValues": {"const": false},
        "containsRawOcrText": {"const": false},
        "containsPredictions": {"const": false},
        "predictionsOpened": {"const": false},
        "promotionAllowed": {"const": false}
      }
    },
    "promotionDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasons"],
      "properties": {
        "status": {"const": "HOLD"},
        "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
