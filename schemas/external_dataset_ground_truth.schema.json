{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hcns/external-dataset-ground-truth-1.0.0.schema.json",
  "title": "External Dataset Ground Truth Review Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dataset", "review", "cases"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "dataset": {"$ref": "#/$defs/dataset"},
    "review": {"$ref": "#/$defs/review"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetId",
        "version",
        "sourceCommit",
        "contentDigest",
        "documentCount",
        "pageCount",
        "groundTruthStatus"
      ],
      "properties": {
        "datasetId": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "contentDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "documentCount": {"type": "integer", "minimum": 1},
        "pageCount": {"type": "integer", "minimum": 1},
        "groundTruthStatus": {"enum": ["DRAFT", "SEALED", "APPROVED"]}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewMethod",
        "reviewer",
        "reviewedAt",
        "evidenceReference",
        "predictionBlindness"
      ],
      "properties": {
        "status": {"enum": ["PENDING", "IN_PROGRESS", "CONFIRMED"]},
        "reviewMethod": {"const": "SOURCE_DOCUMENT_REVIEW"},
        "reviewer": {"type": "string", "minLength": 1},
        "reviewedAt": {"type": ["string", "null"], "format": "date"},
        "evidenceReference": {"type": "string", "minLength": 1},
        "predictionBlindness": {"const": true}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "sourceRelativePath",
        "sourceSha256",
        "pageCount",
        "documentType",
        "fields",
        "expectedQualityStatus",
        "reviewRequired"
      ],
      "properties": {
        "caseId": {"type": "string", "minLength": 1},
        "sourceRelativePath": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sourceSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pageCount": {"type": "integer", "minimum": 1},
        "documentType": {"enum": ["CV", "EMPLOYMENT_CONTRACT", "CERTIFICATE"]},
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/field"}
        },
        "expectedQualityStatus": {"const": "REVIEW_REQUIRED"},
        "reviewRequired": {"type": "boolean"},
        "reviewedAt": {"type": ["string", "null"]},
        "reviewer": {"type": "string", "minLength": 1}
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "sensitive", "reviewStatus"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value": {"type": ["string", "number", "integer", "boolean", "null"]},
        "sensitive": {"type": "boolean"},
        "reviewStatus": {"enum": ["PENDING", "CONFIRMED"]}
      }
    }
  }
}
