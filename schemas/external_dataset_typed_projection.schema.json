{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hcns/external-dataset-typed-projection-1.0.0.schema.json",
  "title": "External Dataset Typed Canonical Projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dataset", "sourcePolicy", "documents"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "dataset": {"$ref": "#/$defs/dataset"},
    "sourcePolicy": {"$ref": "#/$defs/sourcePolicy"},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/document"}
    }
  },
  "$defs": {
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetId", "version", "contentDigest", "groundTruthSha256", "groundTruthStatus"],
      "properties": {
        "datasetId": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "contentDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "groundTruthSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "groundTruthStatus": {"const": "SEALED"}
      }
    },
    "sourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localOnly", "sourceValuesPreserved", "predictionsOpened", "predictionBlind"],
      "properties": {
        "localOnly": {"const": true},
        "sourceValuesPreserved": {"const": true},
        "predictionsOpened": {"const": false},
        "predictionBlind": {"const": true}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "category", "documentType", "sourceFormat", "pageCount", "scopeStatus", "fields"],
      "properties": {
        "caseId": {"type": "string", "pattern": "^(cv|contract|ielts)-[0-9]{3}$"},
        "category": {"enum": ["cv", "contract", "ielts"]},
        "documentType": {"enum": ["CV", "EMPLOYMENT_CONTRACT", "CERTIFICATE"]},
        "sourceFormat": {"enum": ["PLAIN_TEXT", "DOCX", "IMAGE", "PDF_TEXT", "PDF_SCAN", "PPTX"]},
        "pageCount": {"type": "integer", "minimum": 1},
        "scopeStatus": {"enum": ["ACTIVE", "OUT_OF_SCOPE"]},
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/field"}
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reviewStatus", "sourceValue", "dataType", "normalizedValue", "normalizationStatus"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "reviewStatus": {"enum": ["PENDING", "CONFIRMED"]},
        "sourceValue": {"type": ["string", "number", "integer", "boolean", "null"]},
        "dataType": {"enum": ["string", "number", "integer", "date"]},
        "normalizedValue": {"type": ["string", "number", "integer", "null"]},
        "normalizationStatus": {"enum": ["NORMALIZED", "MISSING", "NEEDS_REVIEW", "OUT_OF_SCOPE"]},
        "normalizationReason": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "currency": {"type": "string", "minLength": 1},
        "semantic": {"type": "string", "minLength": 1},
        "scale": {"type": "string", "minLength": 1},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "step": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
