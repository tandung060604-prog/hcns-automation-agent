{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hcns/business_document.schema.json",
  "title": "HCNS Business Document",
  "type": "object",
  "required": [
    "schemaVersion",
    "documentId",
    "sourceFormat",
    "documentType",
    "classification",
    "reviewStatus",
    "quality",
    "fields"
  ],
  "properties": {
    "schemaVersion": {"const": "2.0.0"},
    "documentId": {"type": "string", "minLength": 1},
    "sourceFormat": {"type": "string"},
    "documentType": {"type": "string"},
    "classification": {
      "type": "object",
      "required": ["confidence", "classifier", "candidates"],
      "properties": {
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "classifier": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["documentType", "confidence", "matchedMarkers"],
            "properties": {
              "documentType": {"type": "string"},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "matchedMarkers": {
                "type": "array",
                "items": {"type": "string"}
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "reviewStatus": {
      "enum": ["NOT_REQUIRED", "PENDING", "APPROVED", "CORRECTED", "REJECTED"]
    },
    "quality": {
      "type": "object",
      "required": ["score", "status", "reviewRequired", "reasons", "issues"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["PASS", "REVIEW_REQUIRED", "REJECTED"]},
        "reviewRequired": {"type": "boolean"},
        "reasons": {
          "type": "array",
          "items": {"type": "string"}
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message", "severity"],
            "properties": {
              "code": {"type": "string"},
              "message": {"type": "string"},
              "severity": {"enum": ["INFO", "WARNING", "ERROR"]},
              "fieldName": {"type": "string"},
              "source": {"$ref": "#/$defs/sourceLocation"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value",
          "confidence",
          "status",
          "sensitive",
          "extractor",
          "provenance"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "value": {},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "status": {
            "enum": ["ACCEPTED", "NEEDS_REVIEW", "NOT_FOUND", "INVALID"]
          },
          "sensitive": {"type": "boolean"},
          "extractor": {
            "type": "object",
            "required": ["name", "version"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["method", "source"],
              "properties": {
                "method": {"type": "string", "minLength": 1},
                "source": {"$ref": "#/$defs/sourceLocation"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sourceLocation": {
      "type": "object",
      "properties": {
        "sourceReference": {"type": "string"},
        "pageIndex": {"type": "integer", "minimum": 0},
        "blockIndex": {"type": "integer", "minimum": 0},
        "sheetName": {"type": "string"},
        "rowIndex": {"type": "integer", "minimum": 1},
        "columnIndex": {"type": "integer", "minimum": 1},
        "boundingBox": {
          "type": "object",
          "required": ["x0", "y0", "x1", "y1", "coordinateSpace"],
          "properties": {
            "x0": {"type": "number"},
            "y0": {"type": "number"},
            "x1": {"type": "number"},
            "y1": {"type": "number"},
            "coordinateSpace": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
