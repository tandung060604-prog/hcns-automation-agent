{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hcns-agent/recognition-predictions.schema.json",
  "title": "Vietnamese Recognition Predictions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "datasetId",
    "datasetVersion",
    "backendName",
    "backendVersion",
    "modelIdentifier",
    "cases"
  ],
  "properties": {
    "datasetId": {"type": "string", "minLength": 1},
    "datasetVersion": {"type": "string", "minLength": 1},
    "backendName": {"type": "string", "minLength": 1},
    "backendVersion": {"type": "string", "minLength": 1},
    "modelIdentifier": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "text", "confidence", "durationMs"],
        "properties": {
          "caseId": {"type": "string", "minLength": 1},
          "text": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "durationMs": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
