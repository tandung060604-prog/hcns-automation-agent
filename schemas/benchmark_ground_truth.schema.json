{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hcns/benchmark-ground-truth-1.0.0.schema.json",
  "title": "HCNS Benchmark Ground Truth",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifest", "cases"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "manifest": {
      "$ref": "#/$defs/manifest"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/groundTruthCase"
      }
    }
  },
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetId",
        "version",
        "contentDigest",
        "purpose",
        "rightsBasis",
        "dataOwner",
        "approvedBy",
        "approvalReference",
        "approvedAt",
        "retentionUntil",
        "authorizationStatus",
        "storageProtection",
        "dataClassification",
        "documentCount",
        "pageCount"
      ],
      "properties": {
        "datasetId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "rightsBasis": {
          "type": "string",
          "minLength": 1
        },
        "dataOwner": {
          "type": "string",
          "minLength": 1
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1
        },
        "approvalReference": {
          "type": "string",
          "minLength": 1
        },
        "approvedAt": {
          "type": "string",
          "format": "date"
        },
        "retentionUntil": {
          "type": "string",
          "format": "date"
        },
        "authorizationStatus": {
          "enum": ["DRAFT", "APPROVED", "REVOKED"]
        },
        "storageProtection": {
          "enum": [
            "UNVERIFIED",
            "ENCRYPTED_VOLUME",
            "EFS",
            "ENTERPRISE_MANAGED"
          ]
        },
        "dataClassification": {
          "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]
        },
        "documentCount": {
          "type": "integer",
          "minimum": 1
        },
        "pageCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "groundTruthCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "sourceRelativePath",
        "sourceSha256",
        "pageCount",
        "documentType",
        "fields",
        "expectedQualityStatus",
        "reviewRequired"
      ],
      "properties": {
        "caseId": {
          "type": "string",
          "minLength": 1
        },
        "sourceRelativePath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pageCount": {
          "type": "integer",
          "minimum": 1
        },
        "documentType": {
          "$ref": "#/$defs/documentType"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expectedField"
          }
        },
        "expectedQualityStatus": {
          "$ref": "#/$defs/qualityStatus"
        },
        "reviewRequired": {
          "type": "boolean"
        },
        "ocrLines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "expectedField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "sensitive"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": ["string", "integer", "number", "boolean", "null"]
        },
        "sensitive": {
          "type": "boolean"
        }
      }
    },
    "documentType": {
      "enum": [
        "CV",
        "EMPLOYEE_PROFILE",
        "IDENTITY_CARD",
        "PASSPORT",
        "EMPLOYMENT_CONTRACT",
        "CONTRACT_APPENDIX",
        "HR_DECISION",
        "LEAVE_REQUEST",
        "BUSINESS_TRIP_REQUEST",
        "PAYROLL",
        "CERTIFICATE",
        "DEGREE",
        "INTERNAL_POLICY",
        "OFFICIAL_DISPATCH",
        "ADMINISTRATIVE_FORM",
        "UNKNOWN"
      ]
    },
    "qualityStatus": {
      "enum": ["PASS", "REVIEW_REQUIRED", "REJECTED"]
    }
  }
}
