{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hcns:idp:phase17:timesheet:2.0.0",
  "title": "Phase 17 Timesheet Business JSON",
  "type": "object",
  "required": [
    "schemaVersion",
    "documentFamily",
    "documentType",
    "idpStatus",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "documentFamily": {
      "const": "EMPLOYEE_FORM_TABLE"
    },
    "documentType": {
      "const": "TIMESHEET"
    },
    "idpStatus": {
      "enum": [
        "READY",
        "NEEDS_REVIEW"
      ]
    },
    "payload": {
      "type": "object",
      "required": [
        "fields",
        "tables",
        "summary"
      ],
      "properties": {
        "fields": {
          "type": "object",
          "required": [
            "timesheetPeriod",
            "totalEmployees",
            "companyName"
          ],
          "additionalProperties": false
        },
        "tables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "tableType",
              "rows",
              "summary"
            ],
            "properties": {
              "tableType": {
                "const": "TIMESHEET_EMPLOYEES"
              },
              "rows": {
                "type": "array"
              },
              "summary": {
                "type": "object"
              }
            }
          }
        },
        "summary": {
          "type": "object"
        }
      }
    }
  }
}
