{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hcns:external:certificate:2.0.0",
  "title": "External Dataset Certificate Business JSON v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentFamily", "documentType", "idpStatus", "payload"],
  "properties": {
    "schemaVersion": {"const": "2.0.0"},
    "documentFamily": {"const": "CERTIFICATE"},
    "documentType": {"const": "CERTIFICATE"},
    "idpStatus": {"enum": ["READY", "NEEDS_REVIEW"]},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "tables", "summary"],
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "recipient_name",
            "credential_id",
            "credential_type",
            "overall_score",
            "issue_date"
          ],
          "properties": {
            "recipient_name": {
              "type": ["string", "null"],
              "description": "Full printed recipient name in IELTS order: family name + first name; preserve the source order and characters."
            },
            "credential_id": {"type": ["string", "null"]},
            "credential_type": {"type": ["string", "null"]},
            "overall_score": {"type": ["number", "string", "null"]},
            "issue_date": {"type": ["string", "null"]}
          }
        },
        "tables": {"type": "array"},
        "summary": {"type": "object"}
      }
    }
  }
}
