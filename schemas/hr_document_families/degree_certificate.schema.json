{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hcns:idp:phase15:degree-certificate:2.0.0",
  "title": "Phase 15 Degree and Certificate Business JSON",
  "type": "object",
  "required": ["schemaVersion", "documentFamily", "documentType", "idpStatus", "payload"],
  "properties": {
    "schemaVersion": {"const": "2.0.0"},
    "documentFamily": {"const": "DEGREE_CERTIFICATE"},
    "documentType": {"const": "DEGREE_CERTIFICATE"},
    "idpStatus": {"enum": ["READY", "NEEDS_REVIEW"]},
    "payload": {
      "type": "object",
      "required": ["fields", "tables", "summary"],
      "properties": {
        "fields": {
          "type": "object",
          "required": [
            "recipientName",
            "credentialType",
            "credentialId",
            "issuingOrganization",
            "fieldOfStudy",
            "degreeLevel",
            "classification",
            "issueDate"
          ]
        },
        "tables": {"type": "array"},
        "summary": {"type": "object"}
      }
    }
  }
}
