{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hcns:idp:phase15:cv:2.0.0",
  "title": "HCNS CV Business JSON v2",
  "type": "object",
  "required": ["schemaVersion", "documentFamily", "documentType", "idpStatus", "payload"],
  "properties": {
    "schemaVersion": {"const": "2.0.0"},
    "documentFamily": {"const": "CV"},
    "documentType": {"const": "CV"},
    "idpStatus": {"enum": ["READY", "NEEDS_REVIEW"]},
    "payload": {
      "type": "object",
      "required": ["fields", "tables", "summary"],
      "properties": {
        "fields": {
          "type": "object",
          "required": [
            "full_name",
            "headline",
            "email",
            "phone_number",
            "address",
            "desired_role",
            "years_experience",
            "experience",
            "skills",
            "education"
          ],
          "properties": {
            "full_name": {"type": ["string", "null"]},
            "headline": {"type": ["string", "null"]},
            "email": {"type": ["string", "null"]},
            "phone_number": {"type": ["string", "null"]},
            "address": {"type": ["string", "null"]},
            "desired_role": {"type": ["string", "null"]},
            "years_experience": {"type": ["number", "string", "null"]},
            "experience": {"type": ["string", "null"]},
            "skills": {"type": ["string", "null"]},
            "education": {"type": ["string", "null"]}
          }
        },
        "tables": {"type": "array"},
        "summary": {"type": "object"}
      }
    }
  }
}
