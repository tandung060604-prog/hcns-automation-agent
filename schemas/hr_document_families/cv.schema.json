{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hcns:idp:phase15:cv:2.0.0",
  "title": "Phase 15 CV Business JSON",
  "type": "object",
  "required": ["schemaVersion", "documentFamily", "documentType", "idpStatus", "payload"],
  "properties": {
    "schemaVersion": {"const": "2.0.0"},
    "documentFamily": {"const": "CV"},
    "documentType": {"const": "CV"},
    "idpStatus": {"enum": ["READY", "NEEDS_REVIEW"]},
    "payload": {
      "type": "object",
      "required": ["fields", "tables", "summary"],
      "properties": {
        "fields": {
          "type": "object",
          "required": [
            "fullName",
            "headline",
            "email",
            "phoneNumber",
            "address",
            "education",
            "experience",
            "skills"
          ]
        },
        "tables": {"type": "array"},
        "summary": {"type": "object"}
      }
    }
  }
}
