{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hcns:idp:phase15:administrative-request:2.0.0",
  "title": "Phase 15 Administrative Request Business JSON",
  "type": "object",
  "required": ["schemaVersion", "documentFamily", "documentType", "idpStatus", "payload"],
  "properties": {
    "schemaVersion": {"const": "2.0.0"},
    "documentFamily": {"const": "ADMINISTRATIVE_REQUEST"},
    "documentType": {
      "enum": [
        "LEAVE_REQUEST",
        "OVERTIME_REQUEST",
        "BUSINESS_TRIP_REQUEST",
        "EQUIPMENT_REQUEST",
        "EMPLOYEE_INFO_UPDATE"
      ]
    },
    "idpStatus": {"enum": ["READY", "NEEDS_REVIEW"]},
    "payload": {
      "type": "object",
      "required": ["fields", "tables", "summary"],
      "properties": {
        "fields": {
          "type": "object",
          "required": [
            "documentTitle",
            "requestNumber",
            "employeeName",
            "employeeId",
            "department",
            "jobTitle",
            "reason",
            "startDate",
            "endDate"
          ]
        },
        "tables": {"type": "array"},
        "summary": {"type": "object"}
      }
    }
  }
}
