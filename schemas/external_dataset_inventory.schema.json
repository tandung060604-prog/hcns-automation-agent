{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hcns/external-dataset-inventory-1.0.0.schema.json",
  "title": "HCNS External Dataset Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dataset", "cases"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "dataset": {"$ref": "#/$defs/dataset"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetId", "version", "sourceCommit", "contentDigest",
        "documentCount", "pageCount", "purpose", "rightsBasis", "dataOwner",
        "approvedBy", "approvalReference", "approvedAt", "retentionUntil",
        "authorizationStatus", "storageProtection", "dataClassification"
      ],
      "properties": {
        "datasetId": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "contentDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "documentCount": {"type": "integer", "minimum": 1},
        "pageCount": {"type": "integer", "minimum": 1},
        "purpose": {"type": "string", "minLength": 1},
        "rightsBasis": {"type": "string", "minLength": 1},
        "dataOwner": {"type": "string", "minLength": 1},
        "approvedBy": {"type": "string", "minLength": 1},
        "approvalReference": {"type": "string", "minLength": 1},
        "approvedAt": {"type": "string", "format": "date"},
        "retentionUntil": {"type": "string", "format": "date"},
        "authorizationStatus": {"enum": ["DRAFT", "APPROVED", "REVOKED"]},
        "storageProtection": {
          "enum": ["UNVERIFIED", "ENCRYPTED_VOLUME", "EFS", "ENTERPRISE_MANAGED"]
        },
        "dataClassification": {
          "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId", "category", "sourceRelativePath", "sourceSha256", "sizeBytes",
        "sourceFormat", "documentType", "pageCount"
      ],
      "properties": {
        "caseId": {"type": "string", "pattern": "^(cv|contract|ielts)-[0-9]{3}$"},
        "category": {"enum": ["cv", "contract", "ielts"]},
        "sourceRelativePath": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sourceSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "sizeBytes": {"type": "integer", "minimum": 1},
        "sourceFormat": {
          "enum": ["PLAIN_TEXT", "DOCX", "IMAGE", "PDF_TEXT", "PDF_SCAN", "PPTX"]
        },
        "documentType": {"enum": ["CV", "EMPLOYMENT_CONTRACT", "CERTIFICATE"]},
        "pageCount": {"type": "integer", "minimum": 1}
      }
    }
  }
}
