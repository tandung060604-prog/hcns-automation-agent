{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hcns/external-dataset-mapping-1.0.0.schema.json",
  "title": "HCNS External Dataset Contract Mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetId", "datasetVersion", "sourceCommit", "groundTruthStatus", "promotionAllowed", "mappings"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "datasetId": {"type": "string", "minLength": 1},
    "datasetVersion": {"type": "string", "minLength": 1},
    "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "groundTruthStatus": {"enum": ["NOT_PROVIDED", "DRAFT", "SEALED", "APPROVED"]},
    "promotionAllowed": {"const": false},
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "documentType", "businessFamily", "route", "templateFirst", "schemaRef", "formatPolicy"],
        "properties": {
          "category": {"type": "string", "minLength": 1},
          "documentType": {"type": "string", "minLength": 1},
          "businessFamily": {"type": "string", "minLength": 1},
          "route": {"const": "GENERIC_IDP"},
          "templateFirst": {"const": "UNSUPPORTED"},
          "schemaRef": {"type": ["string", "null"]},
          "formatPolicy": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "string", "minLength": 1}
          },
          "mappingNote": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
