{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hcns.local/schemas/templates/leave_request_v1.schema.json",
  "title": "Template-first Leave Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documentId",
    "documentType",
    "templateId",
    "templateVersion",
    "documentTitle",
    "formNumber",
    "organization",
    "employeeName",
    "employeeId",
    "jobTitle",
    "department",
    "address",
    "phone",
    "requestDate",
    "leaveDays",
    "startDate",
    "endDate",
    "reason",
    "expectedReturnDate",
    "handoverTo",
    "handoverDepartment",
    "handoverTasks",
    "approverName",
    "missingFields",
    "validationErrors",
    "confidence",
    "recommendedAction",
    "sourceFile"
  ],
  "properties": {
    "documentId": {"type": "string", "minLength": 1},
    "documentType": {"const": "LEAVE_REQUEST"},
    "templateId": {"const": "leave-request-v1"},
    "templateVersion": {"const": "1.0"},
    "documentTitle": {"const": "ĐƠN XIN NGHỈ PHÉP"},
    "formNumber": {"type": ["string", "null"]},
    "organization": {"type": ["string", "null"]},
    "employeeName": {"type": ["string", "null"]},
    "employeeId": {"type": ["string", "null"]},
    "jobTitle": {"type": ["string", "null"]},
    "department": {"type": ["string", "null"]},
    "address": {"type": ["string", "null"]},
    "phone": {"type": ["string", "null"]},
    "requestDate": {"type": ["string", "null"], "format": "date"},
    "leaveDays": {"type": ["integer", "number", "null"], "exclusiveMinimum": 0},
    "startDate": {"type": ["string", "null"], "format": "date"},
    "endDate": {"type": ["string", "null"], "format": "date"},
    "reason": {"type": ["string", "null"]},
    "expectedReturnDate": {"type": ["string", "null"], "format": "date"},
    "handoverTo": {"type": ["string", "null"]},
    "handoverDepartment": {"type": ["string", "null"]},
    "handoverTasks": {"type": ["string", "null"]},
    "approverName": {"type": ["string", "null"]},
    "missingFields": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "validationErrors": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "recommendedAction": {
      "enum": ["AUTO_CONTINUE", "MANUAL_REVIEW", "REJECT_UNSUPPORTED", "TECHNICAL_ERROR"]
    },
    "sourceFile": {"type": ["string", "null"]}
  }
}
