{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hcns/benchmark-predictions-1.0.0.schema.json",
  "title": "HCNS Benchmark Predictions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetId",
    "datasetVersion",
    "backendName",
    "backendVersion",
    "modelIdentifiers",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "datasetId": {
      "type": "string",
      "minLength": 1
    },
    "datasetVersion": {
      "type": "string",
      "minLength": 1
    },
    "backendName": {
      "type": "string",
      "minLength": 1
    },
    "backendVersion": {
      "type": "string",
      "minLength": 1
    },
    "modelIdentifiers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/predictionCase"
      }
    }
  },
  "$defs": {
    "predictionCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "documentType",
        "fields",
        "qualityStatus",
        "reviewRequired",
        "latencyMs"
      ],
      "properties": {
        "caseId": {
          "type": "string",
          "minLength": 1
        },
        "documentType": {
          "$ref": "#/$defs/documentType"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predictedField"
          }
        },
        "qualityStatus": {
          "$ref": "#/$defs/qualityStatus"
        },
        "reviewRequired": {
          "type": "boolean"
        },
        "latencyMs": {
          "type": "number",
          "minimum": 0
        },
        "failureCode": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "ocrLines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "predictedField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "status", "sensitive"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": ["string", "integer", "number", "boolean", "null"]
        },
        "status": {
          "enum": ["ACCEPTED", "NEEDS_REVIEW", "NOT_FOUND", "INVALID"]
        },
        "sensitive": {
          "type": "boolean"
        }
      }
    },
    "documentType": {
      "enum": [
        "CV",
        "EMPLOYEE_PROFILE",
        "IDENTITY_CARD",
        "PASSPORT",
        "EMPLOYMENT_CONTRACT",
        "CONTRACT_APPENDIX",
        "HR_DECISION",
        "LEAVE_REQUEST",
        "BUSINESS_TRIP_REQUEST",
        "PAYROLL",
        "CERTIFICATE",
        "DEGREE",
        "INTERNAL_POLICY",
        "OFFICIAL_DISPATCH",
        "ADMINISTRATIVE_FORM",
        "UNKNOWN"
      ]
    },
    "qualityStatus": {
      "enum": ["PASS", "REVIEW_REQUIRED", "REJECTED"]
    }
  }
}
