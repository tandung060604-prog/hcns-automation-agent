{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hcns/benchmark-comparison-1.0.0.schema.json",
  "title": "HCNS Aggregate Benchmark Comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "baseline",
    "challenger",
    "promotionDecision"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "baseline": {
      "$ref": "benchmark_report.schema.json"
    },
    "challenger": {
      "$ref": "benchmark_report.schema.json"
    },
    "promotionDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": {
          "enum": ["PROMOTE", "HOLD"]
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "passed", "message"],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "passed": {
                "type": "boolean"
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
