<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_HR_Document_Agent_MVP_V2" targetNamespace="http://example.com/hr-document-agent-mvp-v2" exporter="OpenAI BPMN Review" exporterVersion="2.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.13.0">
  <bpmn:error id="Error_Document_Input_Invalid" name="Document input invalid" errorCode="DOCUMENT_INPUT_INVALID"/>
  <bpmn:error id="Error_Correction_Invalid" name="Correction invalid" errorCode="CORRECTION_INVALID"/>
  <bpmn:process id="hr_document_agent_mvp_v2" name="HR Document Processing and Onboarding Agent MVP V2" isExecutable="true" camunda:versionTag="2.4.0-shadow" camunda:historyTimeToLive="30">
    <bpmn:documentation>Camunda 7 M5 review-first closed set for six HR document types: leave, overtime, CV, IELTS certificate, probation contract and front-side Vietnamese citizen ID. Raw files, OCR text and full PII remain outside Camunda; autoContinueEnabled=false and HRIS/notification side effects are simulated.</bpmn:documentation>
    <bpmn:startEvent id="Start" name="Bắt đầu">
      <bpmn:documentation>Khởi tạo reuploadCount=0, maxReuploadAttempts=3 và autoContinueEnabled=false trong engine; người nộp không được sửa chính sách này.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener event="start">
          <camunda:script scriptFormat="javascript">var Long = Java.type('java.lang.Long');
execution.setVariable('reuploadCount', Long.valueOf(0));
execution.setVariable('maxReuploadAttempts', Long.valueOf(3));
execution.setVariable('caseVersion', Long.valueOf(1));
execution.setVariable('autoContinueEnabled', false);</camunda:script>
        </camunda:executionListener>
      </bpmn:extensionElements>
      <bpmn:outgoing>F_StartSubmit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask camunda:candidateGroups="employees,newHires" id="Submit" name="Cung cấp tài liệu HCNS">
      <bpmn:documentation>Người nộp chỉ cung cấp applicationId, opaque documentReference và loại tài liệu. Không upload raw image vào process variables.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">execution.setVariable('idempotencyKey', String(execution.getVariable('applicationId')) + ':' + String(execution.getVariable('documentReference')));</camunda:script>
        </camunda:executionListener>
        <camunda:formData>
          <camunda:formField id="applicationId" label="Mã hồ sơ" type="string">
            <camunda:validation>
              <camunda:constraint name="required"/>
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="documentReference" label="Mã tham chiếu tài liệu" type="string">
            <camunda:validation>
              <camunda:constraint name="required"/>
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="declaredDocumentType" label="Loại tài liệu khai báo" type="enum">
            <camunda:value id="LEAVE_REQUEST" name="Đơn nghỉ phép"/>
            <camunda:value id="OVERTIME_REQUEST" name="Đơn tăng ca"/>
            <camunda:value id="CV" name="CV"/>
            <camunda:value id="CERTIFICATE" name="IELTS certificate"/>
            <camunda:value id="EMPLOYMENT_CONTRACT" name="Probation contract"/>
            <camunda:value id="IDENTITY_DOCUMENT" name="Citizen ID front"/>
            <camunda:validation>
              <camunda:constraint name="required"/>
            </camunda:validation>
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>F_StartSubmit</bpmn:incoming>
      <bpmn:outgoing>F_SubmitValidate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask camunda:type="external" camunda:topic="document_validate_file" id="Validate" name="Kiểm tra file">
      <bpmn:documentation>Worker kiểm tra reference, định dạng, dung lượng và khả năng đọc. Complete với fileValidationStatus=VALID/INVALID. Input corrupt/không resolve được có thể báo BPMN Error DOCUMENT_INPUT_INVALID. Timeout/crash phải dùng failure để retry/incident.</bpmn:documentation>
      <bpmn:incoming>F_SubmitValidate</bpmn:incoming>
      <bpmn:incoming>F_UploadValidate</bpmn:incoming>
      <bpmn:outgoing>F_ValidateGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway default="F_FileInvalidReupload" id="GFileValid" name="File hợp lệ?">
      <bpmn:incoming>F_ValidateGateway</bpmn:incoming>
      <bpmn:outgoing>F_FileValidDetect</bpmn:outgoing>
      <bpmn:outgoing>F_FileInvalidReupload</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask camunda:type="external" camunda:topic="document_detect_type" id="Detect" name="Nhận diện loại tài liệu">
      <bpmn:documentation>Worker trả classificationStatus thuộc CONFIRMED, MISMATCH, UNKNOWN hoặc INVALID; không trả raw OCR text.</bpmn:documentation>
      <bpmn:incoming>F_OCRExtract</bpmn:incoming>
      <bpmn:outgoing>F_DetectClass</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway default="F_ClassInvalid" id="GClass" name="Loại tài liệu hợp lệ?">
      <bpmn:incoming>F_DetectClass</bpmn:incoming>
      <bpmn:outgoing>F_ClassConfirmed</bpmn:outgoing>
      <bpmn:outgoing>F_ClassNeedsConfirm</bpmn:outgoing>
      <bpmn:outgoing>F_ClassInvalid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask camunda:candidateGroups="employees,newHires" id="ConfirmType" name="Xác nhận loại tài liệu">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">if (execution.getVariable('documentTypeDecision') == 'CONFIRMED') { execution.setVariable('workflowDocumentType', execution.getVariable('confirmedDocumentType')); }</camunda:script>
        </camunda:executionListener>
        <camunda:formData>
          <camunda:formField id="confirmedDocumentType" label="Loại tài liệu xác nhận" type="enum">
            <camunda:value id="LEAVE_REQUEST" name="Đơn nghỉ phép"/>
            <camunda:value id="OVERTIME_REQUEST" name="Đơn tăng ca"/>
            <camunda:value id="CV" name="CV"/>
            <camunda:value id="CERTIFICATE" name="IELTS certificate"/>
            <camunda:value id="EMPLOYMENT_CONTRACT" name="Probation contract"/>
            <camunda:value id="IDENTITY_DOCUMENT" name="Citizen ID front"/>
            <camunda:validation>
              <camunda:constraint name="required"/>
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="documentTypeDecision" label="Quyết định" type="enum">
            <camunda:value id="CONFIRMED" name="Xác nhận và tiếp tục"/>
            <camunda:value id="REQUEST_REUPLOAD" name="Yêu cầu tải lại"/>
            <camunda:validation>
              <camunda:constraint name="required"/>
            </camunda:validation>
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ClassNeedsConfirm</bpmn:incoming>
      <bpmn:outgoing>F_ConfirmTypeGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway default="F_TypeReupload" id="GType" name="Kết quả xác nhận">
      <bpmn:incoming>F_ConfirmTypeGateway</bpmn:incoming>
      <bpmn:outgoing>F_TypeConfirmed</bpmn:outgoing>
      <bpmn:outgoing>F_TypeReupload</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask camunda:type="external" camunda:topic="document_parse_content" id="OCR" name="Đọc và chuẩn hóa tài liệu">
      <bpmn:documentation>Worker ưu tiên native parser và chỉ OCR ảnh/PDF scan. Raw file, raw text và full PII chỉ tồn tại trong private storage hoặc memory. Camunda chỉ nhận opaque resultReference cùng sanitized status.</bpmn:documentation>
      <bpmn:incoming>F_FileValidDetect</bpmn:incoming>
      <bpmn:outgoing>F_OCRExtract</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask camunda:type="external" camunda:topic="document_extract" id="Extract" name="Trích xuất trường dữ liệu">
      <bpmn:documentation>Trích xuất theo schema từng loại tài liệu. Full values không được ghi vào Camunda history; worker cập nhật artifact sau opaque resultReference.</bpmn:documentation>
      <bpmn:incoming>F_ClassConfirmed</bpmn:incoming>
      <bpmn:incoming>F_TypeConfirmed</bpmn:incoming>
      <bpmn:outgoing>F_ExtractNormalize</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask camunda:type="external" camunda:topic="document_normalize_validate" id="Normalize" name="Chuẩn hóa và kiểm tra dữ liệu">
      <bpmn:documentation>Worker trả các biến sanitized: qualityStatus, reviewRequired, sensitiveFieldNeedsReview, requiredFieldsComplete, missingCriticalField, businessInconsistency và overallConfidence. Không trả preview hoặc field value.</bpmn:documentation>
      <bpmn:incoming>F_ExtractNormalize</bpmn:incoming>
      <bpmn:incoming>F_CorrectionsNormalize</bpmn:incoming>
      <bpmn:outgoing>F_NormalizeQuality</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask camunda:decisionRef="hr-document-quality-routing" camunda:decisionRefBinding="latest" camunda:resultVariable="recommendedAction" camunda:mapDecisionResult="singleEntry" id="QualityDecision" name="Quyết định chất lượng OCR">
      <bpmn:documentation>DMN tách threshold khỏi Python worker và trả recommendedAction: AUTO_CONTINUE, USER_REVIEW, HR_REVIEW hoặc REQUEST_REUPLOAD.</bpmn:documentation>
      <bpmn:incoming>F_NormalizeQuality</bpmn:incoming>
      <bpmn:outgoing>F_QualityGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway default="F_QDefaultHR" id="GQuality" name="Hướng xử lý">
      <bpmn:incoming>F_QualityGateway</bpmn:incoming>
      <bpmn:outgoing>F_QAuto</bpmn:outgoing>
      <bpmn:outgoing>F_QUser</bpmn:outgoing>
      <bpmn:outgoing>F_QHR</bpmn:outgoing>
      <bpmn:outgoing>F_QReupload</bpmn:outgoing>
      <bpmn:outgoing>F_QDefaultHR</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask camunda:candidateGroups="employees,newHires" id="UserReview" name="Người nộp xác nhận dữ liệu">
      <bpmn:extensionElements>
        <camunda:taskListener event="complete">
          <camunda:script scriptFormat="javascript">var assignee = task.getAssignee();
if (assignee == null || String(assignee).trim().length == 0) { throw 'REVIEWER_ASSIGNMENT_REQUIRED'; }
task.setVariable('reviewerId', String(assignee));
task.setVariable('reviewedAt', new Date().toISOString());
task.setVariable('reviewStage', 'USER');</camunda:script>
        </camunda:taskListener>
        <camunda:formData>
          <camunda:formField id="documentReference" label="Mã tham chiếu nguồn" type="string" defaultValue="${documentReference}">
            <camunda:properties><camunda:property id="readonly" value="true"/></camunda:properties>
          </camunda:formField>
          <camunda:formField id="resultReference" label="Mã tham chiếu kết quả" type="string" defaultValue="${resultReference}">
            <camunda:properties><camunda:property id="readonly" value="true"/></camunda:properties>
          </camunda:formField>
          <camunda:formField id="templateId" label="Template/provenance" type="string" defaultValue="${templateId}">
            <camunda:properties><camunda:property id="readonly" value="true"/></camunda:properties>
          </camunda:formField>
          <camunda:formField id="parserVersion" label="Phiên bản parser" type="string" defaultValue="${parserVersion}">
            <camunda:properties><camunda:property id="readonly" value="true"/></camunda:properties>
          </camunda:formField>
          <camunda:formField id="overallConfidence" label="Confidence" type="string" defaultValue="${overallConfidence}">
            <camunda:properties><camunda:property id="readonly" value="true"/></camunda:properties>
          </camunda:formField>
          <camunda:formField id="validationErrors" label="Mã validation" type="string" defaultValue="${validationErrors}">
            <camunda:properties><camunda:property id="readonly" value="true"/></camunda:properties>
          </camunda:formField>
          <camunda:formField id="reviewReasonCodes" label="Lý do review" type="string" defaultValue="${reviewReasonCodes}">
            <camunda:properties><camunda:property id="readonly" value="true"/></camunda:properties>
          </camunda:formField>
          <camunda:formField id="userReviewDecision" label="Kết quả xác nhận" type="enum">
            <camunda:value id="CONFIRMED" name="Thông tin chính xác"/>
            <camunda:value id="CORRECTED" name="Đã sửa trong hệ thống riêng"/>
            <camunda:value id="REQUEST_REUPLOAD" name="Yêu cầu tải lại"/>
            <camunda:value id="UNRESOLVED" name="Không thể xác nhận"/>
            <camunda:validation>
              <camunda:constraint name="required"/>
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="correctionsReference" label="Mã tham chiếu dữ liệu đã sửa" type="string"/>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>F_QUser</bpmn:incoming>
      <bpmn:outgoing>F_UserAudit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask camunda:type="external" camunda:topic="document_record_review_audit" id="RecordUserReviewAudit" name="Lưu audit người xác nhận">
      <bpmn:documentation>Worker chỉ lưu reviewer ID, timestamp, case version, payload hash, quyết định và opaque references; không lưu field value vào Camunda.</bpmn:documentation>
      <bpmn:incoming>F_UserAudit</bpmn:incoming>
      <bpmn:outgoing>F_UserGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway default="F_UserUnresolved" id="GUserReview" name="Kết quả người nộp">
      <bpmn:incoming>F_UserGateway</bpmn:incoming>
      <bpmn:outgoing>F_UserConfirmed</bpmn:outgoing>
      <bpmn:outgoing>F_UserCorrected</bpmn:outgoing>
      <bpmn:outgoing>F_UserReupload</bpmn:outgoing>
      <bpmn:outgoing>F_UserUnresolved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask camunda:candidateGroups="hrReviewers" id="HRReview" name="HCNS kiểm tra dữ liệu">
      <bpmn:extensionElements>
        <camunda:taskListener event="complete">
          <camunda:script scriptFormat="javascript">var assignee = task.getAssignee();
if (assignee == null || String(assignee).trim().length == 0) { throw 'REVIEWER_ASSIGNMENT_REQUIRED'; }
task.setVariable('reviewerId', String(assignee));
task.setVariable('reviewedAt', new Date().toISOString());
task.setVariable('reviewStage', 'HR');</camunda:script>
        </camunda:taskListener>
        <camunda:formData>
          <camunda:formField id="documentReference" label="Mã tham chiếu nguồn" type="string" defaultValue="${documentReference}">
            <camunda:properties><camunda:property id="readonly" value="true"/></camunda:properties>
          </camunda:formField>
          <camunda:formField id="resultReference" label="Mã tham chiếu kết quả" type="string" defaultValue="${resultReference}">
            <camunda:properties><camunda:property id="readonly" value="true"/></camunda:properties>
          </camunda:formField>
          <camunda:formField id="templateId" label="Template/provenance" type="string" defaultValue="${templateId}">
            <camunda:properties><camunda:property id="readonly" value="true"/></camunda:properties>
          </camunda:formField>
          <camunda:formField id="parserVersion" label="Phiên bản parser" type="string" defaultValue="${parserVersion}">
            <camunda:properties><camunda:property id="readonly" value="true"/></camunda:properties>
          </camunda:formField>
          <camunda:formField id="overallConfidence" label="Confidence" type="string" defaultValue="${overallConfidence}">
            <camunda:properties><camunda:property id="readonly" value="true"/></camunda:properties>
          </camunda:formField>
          <camunda:formField id="validationErrors" label="Mã validation" type="string" defaultValue="${validationErrors}">
            <camunda:properties><camunda:property id="readonly" value="true"/></camunda:properties>
          </camunda:formField>
          <camunda:formField id="reviewReasonCodes" label="Lý do review" type="string" defaultValue="${reviewReasonCodes}">
            <camunda:properties><camunda:property id="readonly" value="true"/></camunda:properties>
          </camunda:formField>
          <camunda:formField id="hrReviewDecision" label="Kết quả kiểm tra" type="enum">
            <camunda:value id="CONFIRMED" name="Chấp nhận dữ liệu"/>
            <camunda:value id="CORRECTED" name="Đã sửa trong hệ thống riêng"/>
            <camunda:value id="REQUEST_REUPLOAD" name="Yêu cầu tải lại"/>
            <camunda:value id="REJECTED" name="Từ chối tài liệu"/>
            <camunda:validation>
              <camunda:constraint name="required"/>
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="correctionsReference" label="Mã tham chiếu dữ liệu đã sửa" type="string"/>
          <camunda:formField id="hrReviewNoteReference" label="Mã tham chiếu ghi chú HCNS" type="string"/>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>F_QHR</bpmn:incoming>
      <bpmn:incoming>F_QDefaultHR</bpmn:incoming>
      <bpmn:incoming>F_UserUnresolved</bpmn:incoming>
      <bpmn:incoming>F_UserSlaEscalation</bpmn:incoming>
      <bpmn:incoming>F_CorrectionInvalidHR</bpmn:incoming>
      <bpmn:outgoing>F_HRAudit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask camunda:type="external" camunda:topic="document_record_review_audit" id="RecordHRReviewAudit" name="Lưu audit HCNS">
      <bpmn:documentation>Worker kiểm tra payload hash/case version trước khi lưu audit bất biến; quyết định CORRECTED bắt buộc có correctionsReference.</bpmn:documentation>
      <bpmn:incoming>F_HRAudit</bpmn:incoming>
      <bpmn:outgoing>F_HRGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway default="F_HRRejected" id="GHRReview" name="Kết quả HCNS">
      <bpmn:incoming>F_HRGateway</bpmn:incoming>
      <bpmn:outgoing>F_HRConfirmed</bpmn:outgoing>
      <bpmn:outgoing>F_HRCorrected</bpmn:outgoing>
      <bpmn:outgoing>F_HRReupload</bpmn:outgoing>
      <bpmn:outgoing>F_HRRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask camunda:type="external" camunda:topic="document_apply_corrections" id="ApplyCorrections" name="Áp dụng dữ liệu đã sửa">
      <bpmn:documentation>Worker resolve correctionsReference trong hệ thống riêng, không nhận full corrected fields từ Camunda; sau đó quay lại normalize và DMN.</bpmn:documentation>
      <bpmn:incoming>F_UserCorrected</bpmn:incoming>
      <bpmn:incoming>F_HRCorrected</bpmn:incoming>
      <bpmn:outgoing>F_CorrectionsNormalize</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask camunda:type="external" camunda:topic="document_reupload_control" id="RegisterReupload" name="Kiểm soát lượt tải lại">
      <bpmn:documentation>Worker tăng reuploadCount đúng một lần theo idempotency key applicationId+documentReference. maxReuploadAttempts do engine khởi tạo và không hiển thị cho người dùng.</bpmn:documentation>
      <bpmn:incoming>F_FileInvalidReupload</bpmn:incoming>
      <bpmn:incoming>F_ValidateErrorReupload</bpmn:incoming>
      <bpmn:incoming>F_ClassInvalid</bpmn:incoming>
      <bpmn:incoming>F_TypeReupload</bpmn:incoming>
      <bpmn:incoming>F_OCRErrorReupload</bpmn:incoming>
      <bpmn:incoming>F_QReupload</bpmn:incoming>
      <bpmn:incoming>F_UserReupload</bpmn:incoming>
      <bpmn:incoming>F_HRReupload</bpmn:incoming>
      <bpmn:outgoing>F_RegGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway default="F_ReuploadLimit" id="GReupload" name="Còn lượt tải lại?">
      <bpmn:incoming>F_RegGateway</bpmn:incoming>
      <bpmn:outgoing>F_ReuploadAllowed</bpmn:outgoing>
      <bpmn:outgoing>F_ReuploadLimit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask camunda:candidateGroups="employees,newHires" id="UploadAgain" name="Tải lại tài liệu">
      <bpmn:extensionElements>
        <camunda:executionListener event="end">
          <camunda:script scriptFormat="javascript">execution.setVariable('idempotencyKey', String(execution.getVariable('applicationId')) + ':' + String(execution.getVariable('documentReference')));</camunda:script>
        </camunda:executionListener>
        <camunda:formData>
          <camunda:formField id="documentReference" label="Mã tham chiếu tài liệu mới" type="string">
            <camunda:validation>
              <camunda:constraint name="required"/>
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="declaredDocumentType" label="Loại tài liệu" type="enum">
            <camunda:value id="LEAVE_REQUEST" name="Đơn nghỉ phép"/>
            <camunda:value id="OVERTIME_REQUEST" name="Đơn tăng ca"/>
            <camunda:value id="CV" name="CV"/>
            <camunda:value id="CERTIFICATE" name="IELTS certificate"/>
            <camunda:value id="EMPLOYMENT_CONTRACT" name="Probation contract"/>
            <camunda:value id="IDENTITY_DOCUMENT" name="Citizen ID front"/>
            <camunda:validation>
              <camunda:constraint name="required"/>
            </camunda:validation>
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ReuploadAllowed</bpmn:incoming>
      <bpmn:outgoing>F_UploadValidate</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask camunda:candidateGroups="hrReviewers" id="FinalHR" name="HCNS xử lý khi hết lượt">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="finalHrDecision" label="Quyết định cuối" type="enum">
            <camunda:value id="APPROVED" name="Chấp nhận thủ công"/>
            <camunda:value id="REJECTED" name="Từ chối tài liệu"/>
            <camunda:validation>
              <camunda:constraint name="required"/>
            </camunda:validation>
          </camunda:formField>
          <camunda:formField id="finalHrNoteReference" label="Mã tham chiếu ghi chú quyết định cuối" type="string"/>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>F_ReuploadLimit</bpmn:incoming>
      <bpmn:incoming>F_HRSlaEscalation</bpmn:incoming>
      <bpmn:outgoing>F_FinalGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway default="F_FinalRejected" id="GFinal" name="Quyết định cuối">
      <bpmn:incoming>F_FinalGateway</bpmn:incoming>
      <bpmn:outgoing>F_FinalApproved</bpmn:outgoing>
      <bpmn:outgoing>F_FinalRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GApprovedMerge" name="Hồ sơ được chấp nhận">
      <bpmn:incoming>F_QAuto</bpmn:incoming>
      <bpmn:incoming>F_UserConfirmed</bpmn:incoming>
      <bpmn:incoming>F_HRConfirmed</bpmn:incoming>
      <bpmn:incoming>F_FinalApproved</bpmn:incoming>
      <bpmn:outgoing>F_ApprovedUpdateHRIS</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask camunda:type="external" camunda:topic="hris_update_employee_record" id="UpdateHRIS" name="Cập nhật hồ sơ nhân sự">
      <bpmn:documentation>Bước nghiệp vụ hoàn chỉnh: cập nhật HRIS bằng opaque resultReference hoặc API nội bộ. Technical failure phải retry/incident; thao tác phải idempotent. M4 chỉ dùng mock handler.</bpmn:documentation>
      <bpmn:incoming>F_ApprovedUpdateHRIS</bpmn:incoming>
      <bpmn:outgoing>F_UpdateNotifySuccess</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask camunda:type="external" camunda:topic="hr_notify_processing_result" id="NotifySuccess" name="Thông báo hoàn tất">
      <bpmn:documentation>Gửi thông báo đã hoàn tất bằng template không chứa dữ liệu nhạy cảm trong log.</bpmn:documentation>
      <bpmn:incoming>F_UpdateNotifySuccess</bpmn:incoming>
      <bpmn:outgoing>F_NotifySuccessEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GRejectedMerge" name="Hồ sơ bị từ chối">
      <bpmn:incoming>F_HRRejected</bpmn:incoming>
      <bpmn:incoming>F_FinalRejected</bpmn:incoming>
      <bpmn:outgoing>F_RejectedNotify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask camunda:type="external" camunda:topic="hr_notify_processing_result" id="NotifyRejected" name="Thông báo từ chối">
      <bpmn:documentation>Gửi trạng thái từ chối và hướng dẫn liên hệ HCNS; không ghi full PII vào errorDetails/log.</bpmn:documentation>
      <bpmn:incoming>F_RejectedNotify</bpmn:incoming>
      <bpmn:outgoing>F_NotifyRejectedEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndSuccess" name="Hoàn tất hồ sơ nhân sự">
      <bpmn:incoming>F_NotifySuccessEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndRejected" name="Tài liệu bị từ chối">
      <bpmn:incoming>F_NotifyRejectedEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent attachedToRef="Validate" cancelActivity="true" id="ValidateInputError" name="File/reference không hợp lệ">
      <bpmn:outgoing>F_ValidateErrorReupload</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_Document_Input_Invalid"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent attachedToRef="OCR" cancelActivity="true" id="OCRInputError" name="Đầu vào đọc tài liệu không hợp lệ">
      <bpmn:outgoing>F_OCRErrorReupload</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_Document_Input_Invalid"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent attachedToRef="ApplyCorrections" cancelActivity="true" id="CorrectionInvalid" name="Correction không hợp lệ">
      <bpmn:outgoing>F_CorrectionInvalidHR</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="Error_Correction_Invalid"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent attachedToRef="UserReview" cancelActivity="true" id="UserReviewSla" name="Quá SLA xác nhận">
      <bpmn:outgoing>F_UserSlaEscalation</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration>PT24H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent attachedToRef="HRReview" cancelActivity="true" id="HRReviewSla" name="Quá SLA HCNS">
      <bpmn:outgoing>F_HRSlaEscalation</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration>PT8H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F_StartSubmit" sourceRef="Start" targetRef="Submit"/>
    <bpmn:sequenceFlow id="F_SubmitValidate" sourceRef="Submit" targetRef="Validate"/>
    <bpmn:sequenceFlow id="F_ValidateGateway" sourceRef="Validate" targetRef="GFileValid"/>
    <bpmn:sequenceFlow id="F_FileValidDetect" sourceRef="GFileValid" targetRef="OCR" name="VALID">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${fileValidationStatus == 'VALID'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_FileInvalidReupload" sourceRef="GFileValid" targetRef="RegisterReupload" name="INVALID / UNKNOWN"/>
    <bpmn:sequenceFlow id="F_ValidateErrorReupload" sourceRef="ValidateInputError" targetRef="RegisterReupload" name="DOCUMENT_INPUT_INVALID"/>
    <bpmn:sequenceFlow id="F_DetectClass" sourceRef="Detect" targetRef="GClass"/>
    <bpmn:sequenceFlow id="F_ClassConfirmed" sourceRef="GClass" targetRef="Extract" name="CONFIRMED">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${classificationStatus == 'CONFIRMED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ClassNeedsConfirm" sourceRef="GClass" targetRef="ConfirmType" name="MISMATCH / UNKNOWN">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${classificationStatus == 'MISMATCH' || classificationStatus == 'UNKNOWN'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ClassInvalid" sourceRef="GClass" targetRef="RegisterReupload" name="INVALID"/>
    <bpmn:sequenceFlow id="F_ConfirmTypeGateway" sourceRef="ConfirmType" targetRef="GType"/>
    <bpmn:sequenceFlow id="F_TypeConfirmed" sourceRef="GType" targetRef="Extract" name="CONFIRMED">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${documentTypeDecision == 'CONFIRMED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_TypeReupload" sourceRef="GType" targetRef="RegisterReupload" name="REQUEST_REUPLOAD"/>
    <bpmn:sequenceFlow id="F_OCRExtract" sourceRef="OCR" targetRef="Detect"/>
    <bpmn:sequenceFlow id="F_OCRErrorReupload" sourceRef="OCRInputError" targetRef="RegisterReupload" name="DOCUMENT_INPUT_INVALID"/>
    <bpmn:sequenceFlow id="F_ExtractNormalize" sourceRef="Extract" targetRef="Normalize"/>
    <bpmn:sequenceFlow id="F_NormalizeQuality" sourceRef="Normalize" targetRef="QualityDecision"/>
    <bpmn:sequenceFlow id="F_QualityGateway" sourceRef="QualityDecision" targetRef="GQuality"/>
    <bpmn:sequenceFlow id="F_QAuto" sourceRef="GQuality" targetRef="GApprovedMerge" name="AUTO_CONTINUE">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${recommendedAction == 'AUTO_CONTINUE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_QUser" sourceRef="GQuality" targetRef="UserReview" name="USER_REVIEW">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${recommendedAction == 'USER_REVIEW'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_QHR" sourceRef="GQuality" targetRef="HRReview" name="HR_REVIEW">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${recommendedAction == 'HR_REVIEW'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_QReupload" sourceRef="GQuality" targetRef="RegisterReupload" name="REQUEST_REUPLOAD">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${recommendedAction == 'REQUEST_REUPLOAD'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_QDefaultHR" sourceRef="GQuality" targetRef="HRReview" name="UNKNOWN → HR REVIEW"/>
    <bpmn:sequenceFlow id="F_UserAudit" sourceRef="UserReview" targetRef="RecordUserReviewAudit"/>
    <bpmn:sequenceFlow id="F_UserGateway" sourceRef="RecordUserReviewAudit" targetRef="GUserReview"/>
    <bpmn:sequenceFlow id="F_UserConfirmed" sourceRef="GUserReview" targetRef="GApprovedMerge" name="CONFIRMED">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${userReviewDecision == 'CONFIRMED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_UserCorrected" sourceRef="GUserReview" targetRef="ApplyCorrections" name="CORRECTED">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${userReviewDecision == 'CORRECTED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_UserReupload" sourceRef="GUserReview" targetRef="RegisterReupload" name="REQUEST_REUPLOAD">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${userReviewDecision == 'REQUEST_REUPLOAD'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_UserUnresolved" sourceRef="GUserReview" targetRef="HRReview" name="UNRESOLVED"/>
    <bpmn:sequenceFlow id="F_HRAudit" sourceRef="HRReview" targetRef="RecordHRReviewAudit"/>
    <bpmn:sequenceFlow id="F_HRGateway" sourceRef="RecordHRReviewAudit" targetRef="GHRReview"/>
    <bpmn:sequenceFlow id="F_HRConfirmed" sourceRef="GHRReview" targetRef="GApprovedMerge" name="CONFIRMED">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hrReviewDecision == 'CONFIRMED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_HRCorrected" sourceRef="GHRReview" targetRef="ApplyCorrections" name="CORRECTED">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hrReviewDecision == 'CORRECTED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_HRReupload" sourceRef="GHRReview" targetRef="RegisterReupload" name="REQUEST_REUPLOAD">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hrReviewDecision == 'REQUEST_REUPLOAD'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_HRRejected" sourceRef="GHRReview" targetRef="GRejectedMerge" name="REJECTED"/>
    <bpmn:sequenceFlow id="F_CorrectionsNormalize" sourceRef="ApplyCorrections" targetRef="Normalize"/>
    <bpmn:sequenceFlow id="F_CorrectionInvalidHR" sourceRef="CorrectionInvalid" targetRef="HRReview" name="CORRECTION_INVALID"/>
    <bpmn:sequenceFlow id="F_UserSlaEscalation" sourceRef="UserReviewSla" targetRef="HRReview" name="SLA → HR REVIEW"/>
    <bpmn:sequenceFlow id="F_HRSlaEscalation" sourceRef="HRReviewSla" targetRef="FinalHR" name="SLA → FINAL HR"/>
    <bpmn:sequenceFlow id="F_RegGateway" sourceRef="RegisterReupload" targetRef="GReupload"/>
    <bpmn:sequenceFlow id="F_ReuploadAllowed" sourceRef="GReupload" targetRef="UploadAgain" name="Còn lượt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reuploadCount &lt;= maxReuploadAttempts}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_ReuploadLimit" sourceRef="GReupload" targetRef="FinalHR" name="Hết lượt"/>
    <bpmn:sequenceFlow id="F_UploadValidate" sourceRef="UploadAgain" targetRef="Validate"/>
    <bpmn:sequenceFlow id="F_FinalGateway" sourceRef="FinalHR" targetRef="GFinal"/>
    <bpmn:sequenceFlow id="F_FinalApproved" sourceRef="GFinal" targetRef="GApprovedMerge" name="APPROVED">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${finalHrDecision == 'APPROVED'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F_FinalRejected" sourceRef="GFinal" targetRef="GRejectedMerge" name="REJECTED"/>
    <bpmn:sequenceFlow id="F_ApprovedUpdateHRIS" sourceRef="GApprovedMerge" targetRef="UpdateHRIS"/>
    <bpmn:sequenceFlow id="F_UpdateNotifySuccess" sourceRef="UpdateHRIS" targetRef="NotifySuccess"/>
    <bpmn:sequenceFlow id="F_NotifySuccessEnd" sourceRef="NotifySuccess" targetRef="EndSuccess"/>
    <bpmn:sequenceFlow id="F_RejectedNotify" sourceRef="GRejectedMerge" targetRef="NotifyRejected"/>
    <bpmn:sequenceFlow id="F_NotifyRejectedEnd" sourceRef="NotifyRejected" targetRef="EndRejected"/>
    <bpmn:textAnnotation id="TechnicalFailureNote">
      <bpmn:text>Lỗi kỹ thuật (timeout, worker crash, OCR engine unavailable): worker gọi /failure, giảm retries và tạo incident khi retries=0. Không dùng BPMN Error để che lỗi kỹ thuật.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_TechnicalFailure" sourceRef="OCR" targetRef="TechnicalFailureNote"/>
    <bpmn:group id="GroupAuto" categoryValueRef="CVAuto"/>
    <bpmn:group id="GroupHuman" categoryValueRef="CVHuman"/>
    <bpmn:group id="GroupReupload" categoryValueRef="CVReupload"/>
  </bpmn:process>
  <bpmn:category id="CatAuto">
    <bpmn:categoryValue id="CVAuto" value="AGENT XỬ LÝ TỰ ĐỘNG"/>
  </bpmn:category>
  <bpmn:category id="CatHuman">
    <bpmn:categoryValue id="CVHuman" value="HUMAN-IN-THE-LOOP VÀ HOÀN TẤT NGHIỆP VỤ"/>
  </bpmn:category>
  <bpmn:category id="CatReupload">
    <bpmn:categoryValue id="CVReupload" value="TẢI LẠI VÀ NGOẠI LỆ"/>
  </bpmn:category>
